# ==============================================================================
# .dockerignore - Production Docker Build Context Exclusions
# Prevents sensitive credentials, host dependencies, test suites, scratch files,
# and dev artifacts from leaking into production container images.
# ==============================================================================

# Version Control & CI/CD
.git/
.gitignore
.gitattributes
.github/

# Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Sensitive Credentials & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
gcs-key.json
*-key.json
service-account*.json
*.pem
*.key
*.cert

# Test Suites, Fixtures & Coverage
tests/
__tests__/
test/
*.test.js
*.spec.js
coverage/
.nyc_output/
jest.config.js

# Scratch Scripts & Diagnostic Outputs
test_*.js
_test_*.js
test-*.js
refactor.js
*.old
*.bak
output.txt
*_output.txt
*.log
logs/

# Documentation & Planning Artifacts (README.md is kept for Hugging Face Spaces)
.planning/
docs/
.specs/

# Stray Skills, Agent Metadata & Analysis Reports
*.skill
jsdoc_report.json
.agent/
.gemini/

# Local Database Mounts & Runtime State
mongodb_data/
pids/
*.pid
*.seed
*.pid.lock

# Linters, Formatters & Editor Configs
.eslintcache
eslint.config.js
.prettierrc*
.prettierignore
.editorconfig
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker Infrastructure (Not needed inside container image)
Dockerfile*
docker-compose*.yml
.dockerignore
