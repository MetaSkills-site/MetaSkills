# ==============================================================================
# MetaSkills Monorepo - Unified Environment Variables Template
# ==============================================================================

# ── Backend Configuration (api/.env) ──────────────────────────────────────────

# Core Server & Database
PORT=7860
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/metaskills?retryWrites=true&w=majority
JWT_SECRET=your_jwt_signing_secret_here

# CORS Origin Configuration (Comma-separated; localhost & vercel are built-in)
CORS_ORIGIN=https://metaskills.site,https://metaskills.vercel.app

# Google OAuth (Backend Authentication & Verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# AI Providers & LLM Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# Transactional Emails (Brevo)
BREVO_API_KEY=your_brevo_api_key

# Google Cloud Storage (Audio & Document Uploads - Optional in local dev)
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_SCREENSHOT_BUCKET_NAME=your_gcs_screenshot_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=./gcs-key.json

# Google Drive Auto-Backup (Optional)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ── Frontend Configuration (web) ──────────────────────────────────────────────

VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
